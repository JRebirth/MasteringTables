<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jrebirth</groupId>
		<artifactId>ria</artifactId>
		<version>4.0.0</version>
	</parent>

	<groupId>org.jrebirth.demo</groupId>
	<artifactId>masteringtables</artifactId>
	<version>4.0.0</version>

	<name>Mastering Tables</name>
	<url>http://wip.jrebirth.org/apps/MasteringTables.html</url>
	<description>Mind Game built with JRebirth Framework</description>

	<properties>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<jrebirth.version>12.0.0</jrebirth.version>

		<resources.base.path>org/jrebirth/demo/masteringtables</resources.base.path>
		<vendor>JRebirth</vendor>		
		<appName>Mastering Tables</appName>
		<archiveName>MasteringTables</archiveName>
		<exeIcon>src/main/resources/images/MT.ico</exeIcon>
		<mainModule>org.jrebirth.demo.masteringtables</mainModule>
		<appClass>org.jrebirth.demo.masteringtables.MTApplication</appClass>
		<appVersion>4.0.0</appVersion>
		<!-- Remote path under apps.jrebirth.org (matches AF site Presentation.vm links). -->
		<deployPath>masteringtables/${project.version}</deployPath>

		<ciJob>MasteringTables-master</ciJob>

	</properties>

	<scm>
		<connection>scm:git:git://github.com/JRebirth/MasteringTables.git</connection>
		<developerConnection>
			scm:git:ssh://git@github.com/JRebirth/MasteringTables.git</developerConnection>
		<url>https://github.com/JRebirth/MasteringTables</url>
	</scm>

	<build>

		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.jrebirth.af</groupId>
							<artifactId>processor</artifactId>
							<version>${jrebirth.version}</version>
							<classifier>4ide</classifier>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>wagon-maven-plugin</artifactId>
					<version>1.0</version>
					<configuration>
						<serverId>JRebirth_Sites</serverId>
						<url>
							scp://s143909802.onlinehome.fr/kunden/homepages/14/d143909784/htdocs/jrebirth/apps</url>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<extensions>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ftp</artifactId>
				<version>2.2</version>
			</extension>

			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ssh</artifactId>
				<version>2.10</version>
			</extension>

		</extensions>
	</build>

	<dependencies>

		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.4.14</version>
		</dependency>

		<dependency>
			<groupId>org.jrebirth.af</groupId>
			<artifactId>component</artifactId>
			<version>${jrebirth.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>javafx-swing</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.jrebirth.af</groupId>
			<artifactId>preloader</artifactId>
			<version>${jrebirth.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jrebirth.af</groupId>
			<artifactId>processor</artifactId>
			<version>${jrebirth.version}</version>
			<classifier>4ide</classifier>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.testfx</groupId>
			<artifactId>testfx-core</artifactId>
			<version>4.0.15-alpha</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testfx</groupId>
			<artifactId>testfx-junit</artifactId>
			<version>4.0.15-alpha</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<profiles>
		<!-- Override RIA github-packages URLs for this repo's Packages feed -->
		<profile>
			<id>github-packages</id>
			<properties>
				<repositoryId>github</repositoryId>
				<repositoryName>GitHub Packages Releases</repositoryName>
				<repositoryUrl>https://maven.pkg.github.com/JRebirth/MasteringTables</repositoryUrl>
				<snapshotRepositoryId>github</snapshotRepositoryId>
				<snapshotRepositoryName>GitHub Packages Snapshots</snapshotRepositoryName>
				<snapshotRepositoryUrl>https://maven.pkg.github.com/JRebirth/MasteringTables</snapshotRepositoryUrl>
			</properties>
		</profile>

		<!-- Upload jlink zip produced by -PAPP to apps.jrebirth.org/${deployPath}/ -->
		<profile>
			<id>DeployApps</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>wagon-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>deploy-jlink-zip</id>
								<phase>site-deploy</phase>
								<goals>
									<goal>upload-single</goal>
								</goals>
								<configuration>
									<fromFile>${project.build.directory}/${archiveName}.zip</fromFile>
									<toFile>${deployPath}/${archiveName}-${project.version}.zip</toFile>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
